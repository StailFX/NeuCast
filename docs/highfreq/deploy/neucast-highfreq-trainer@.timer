[Unit]
Description=NeuCast HF Trainer schedule for %I — daily 04:00 UTC
Documentation=file:///opt/neucast/docs/highfreq/architecture.md

[Timer]
# 04:00 UTC = 07:00 MSK. All symbols fire at the same time but
# RandomizedDelaySec=300 (5 min) spreads them to avoid a thundering
# herd on a single trainer process slot.
OnCalendar=*-*-* 04:00:00 UTC
Persistent=true
RandomizedDelaySec=300

# Implicit Unit=neucast-highfreq-trainer@%i.service.

[Install]
WantedBy=timers.target
