[Unit]
Description=NeuCast High-Frequency Web (slim FastAPI for reverse-proxy from Finland)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service neucast-highfreq.service wg-quick@wg0.service
# WireGuard (ADR-010) carries the Finland→Tokyo HTTP traffic. Without
# the tunnel up the uvicorn bind to 10.99.0.1 will fail; Requires= makes
# the failure mode honest (we don't pretend to be reachable when we're
# not). On boot, wg-quick@wg0 starts before us via After=.
Requires=wg-quick@wg0.service
# We don't Require= postgres because the slim app degrades gracefully
# (web.py wraps DB calls in try/except → 503 with structured reason).

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
# Bind to the WireGuard interface IP only (10.99.0.1, ADR-010). We do
# NOT bind to 0.0.0.0 — even with UFW restrictions, exposing the port
# on the public interface would let a misconfigured firewall leak it.
# Binding to 10.99.0.1 makes the OS itself refuse traffic on any other
# interface; the bind() call returns ENETUNREACH if wg0 is down (caught
# by Requires=wg-quick@wg0.service above).
#
# --forwarded-allow-ips: trust X-Forwarded-For only from the WG peer.
ExecStart=/opt/neucast/venv/bin/uvicorn \
    app.highfreq.web_app:app \
    --host 10.99.0.1 \
    --port 8000 \
    --workers 1 \
    --loop uvloop \
    --http httptools \
    --proxy-headers \
    --forwarded-allow-ips=10.99.0.2
Restart=always
RestartSec=5
# Lighter than the ingest box but still snappy. uvicorn + 1 worker +
# ~10 req/sec from polling clients is well under 200 MB.
MemoryMax=400M
MemoryHigh=300M
# Lower priority than the ingest loop (nice -5) — the web layer is
# I/O-bound and tolerant of latency, the ingest is hot.
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
