[Unit]
Description=NeuCast Prometheus TSDB snapshot → Yandex S3 (oneshot)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target prometheus.service
Wants=prometheus.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env

# Needs to read /var/lib/prometheus/ (root-owned) AND have S3 creds —
# easiest as root since the snapshot tarball is short-lived in memory.
ExecStart=/opt/neucast/venv/bin/python -m tools.backup_prometheus_to_s3

MemoryMax=1500M
MemoryHigh=1000M
TimeoutStartSec=900

[Install]
