[Unit]
Description=NeuCast Paper Trader (Phase C runner — sim-only by ADR-005)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service neucast-highfreq.service
# Soft dep on the ingest service: if it isn't up the runner will just
# log "no rows in last 180s" and skip. We don't Requires= it because
# during a brief ingest restart the runner can helpfully report the
# gap rather than dying alongside.
Wants=neucast-highfreq.service

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.paper_trader_runner
Restart=always
RestartSec=10
# Runner is a thin async loop; ~50 MB resident is plenty even with
# pandas pulled in for the feature pipeline. Hard cap at 300 MB so a
# leak shows up loudly.
MemoryMax=300M
MemoryHigh=200M
# The runner only does work once per minute — no need for elevated
# scheduling. Default Nice/IO is right.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

# Graceful shutdown: SIGTERM lets the loop run its force_close path
# (flatten any open position, persist the closing trade) before exiting.
# 30s is generous — the actual shutdown takes <1s.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
