[Unit]
Description=NeuCast HFT L2 archival to Yandex S3 (oneshot, fired by .timer)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
# Postgres must be up — we read + delete from it. Soft dep on the
# ingest service (the runner is what creates the rows we archive); a
# brief ingest restart doesn't change anything for us, just means
# fewer rows on the next run.
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env

# Retention shrunk 7→2 days (release 2026-04-27): caps "still-in-hot
# Postgres, not yet in S3" data loss to ~2 days on a hard Tokyo
# failure. Cost: trivially more S3 storage (the same total data, just
# in S3 instead of Postgres). max-days=30 retained for catch-up safety
# after multi-week downtime.
ExecStart=/opt/neucast/venv/bin/python -m tools.archive_l2_to_s3 \
    --retention-days 2 \
    --max-days 30

# Exit codes:
#   0 = success (or nothing to do)
#   1 = some (symbol, day) failed — we logged + will retry next run.
#       Treat as success at the systemd level so the timer doesn't go
#       into a failed state on a transient S3 hiccup.
SuccessExitStatus=0 1

# Memory caps (bumped 2026-05-08 after a real outage).
#
# Original budget (400M max / 300M high) was set assuming each archive
# run processes ≤1 day per symbol — the steady-state. In a 4-day backlog
# scenario (timer skipped due to upstream issue, or VPS restart),
# ``pd.read_sql_query`` of 86k L2 rows × 30 columns × multiple days
# blows past 300M. cgroup memory.high then *throttles* (not kills) the
# process, which combined with nearly-full system swap (78% used by
# Postgres + uvicorn + redis + celery on this 4G VPS) puts the run into
# an indefinite swap-thrash spin. Symptoms: 60-min wallclock with only
# 54s CPU consumed, no log lines after the first ``read_sql_query``.
#
# 1.5G max / 1.2G high gives a single read_sql_query enough headroom
# for ~5 days of L2 backlog without paging. Steady-state runs use far
# less; this is just the worst-case ceiling. VPS has ~2.3G available
# memory baseline so the cap is well under the system budget.
#
# Long-term TODO: move ``pd.read_sql_query`` to a chunked
# ``COPY TO STDOUT`` pipe so memory is bounded by the chunk size, not
# the day size — then we can return to the tighter 400M/300M cap.
MemoryMax=1500M
MemoryHigh=1200M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# 1h matches the new memory budget — even with 5 days of catch-up
# the run should finish well under this (the live drain on 2026-05-08
# took 23 seconds for 4 days once memory wasn't throttling).
TimeoutStartSec=3600

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
# Activated by the .timer unit, not socket / multi-user.
