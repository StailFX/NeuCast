[Unit]
# T.22 — drift-driven retrain (closes the feedback loop between
# the hourly drift_check cron and the per-symbol trainer service).
#
# Runs every 30 min via the paired .timer. Reads weights/highfreq/
# <sym>_drift.json, asks app.highfreq.drift_retrain_policy whether
# to fire, and if yes runs `systemctl start
# neucast-highfreq-trainer@<sym>.service`. Two safety rails:
#  • cooldown (default 6h) prevents retrain storms when drift JSON
#    stays high all day;
#  • severity gate — only "high" triggers (warn alone is too noisy).
#
# Idempotent — re-running the unit on a stuck-high drift JSON just
# logs "cooldown not yet elapsed" and exits 0.
Description=NeuCast — drift-driven retrain trigger (T.22)
After=neucast-highfreq.service
Wants=neucast-highfreq.service

[Service]
# Runs as root because `systemctl start neucast-highfreq-trainer@*`
# requires it. The trainer unit itself runs as stailfx and writes
# .cbm files owned by stailfx — so root here only fires the start,
# never touches model weights directly.
Type=oneshot
User=root
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
# `sudo -u stailfx` for the actual python invocation so the policy
# evaluation (which only reads weights + DB) doesn't run as root —
# defence in depth. The systemctl start at the end is a child of
# this Python process, so it inherits root. Wait — that's the
# opposite. We need the python to RUN as root for systemctl.start
# to succeed. Keeping the python process as root; tests cover
# that the policy logic itself is read-only and side-effect-free
# except for the textfile + the systemctl.start call.
ExecStart=/opt/neucast/venv/bin/python -m tools.drift_driven_retrain \
    --symbol BTCUSDT --symbol ETHUSDT --symbol BNBUSDT \
    --cooldown-hours 6 \
    --textfile-out /var/lib/node_exporter/textfile_collector/drift_retrain.prom

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
