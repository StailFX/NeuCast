[Unit]
Description=NeuCast HFT OFI 1-sec archival to Yandex S3 (oneshot, fired by .timer)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env

# retention=7 days mirrors the trainer's --since-hours 72 (3 days) with
# a 4-day buffer; a deploy that bumps --since-hours up to 1 week still
# sees no holes. max-days=30 caps catch-up after long downtime.
ExecStart=/opt/neucast/venv/bin/python -m tools.archive_ofi_1s_to_s3 \
    --retention-days 7 \
    --max-days 30

# Treat partial-failure as success so the timer doesn't enter failed
# state on a transient S3 hiccup. The cron-stale alert will catch a
# persistent outage on its own (after >25h of no successful run).
SuccessExitStatus=0 1

MemoryMax=400M
MemoryHigh=300M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=1800

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
# Activated by the .timer unit, not socket / multi-user.
