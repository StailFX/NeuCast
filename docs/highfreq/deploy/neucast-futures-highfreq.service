[Unit]
Description=NeuCast HFT — USDM Futures L2 ingest (Release S, ADR-019)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service
Wants=docker.service
# Coexists with neucast-highfreq.service (spot ingest) — different
# WebSocket host (fstream vs stream), different table, different
# Prometheus port. Both can run side-by-side without conflict.

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
# Default symbols; override per-host in /etc/neucast/env if needed.
Environment=HIGHFREQ_FUTURES_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
# Different metrics port from spot (9090) — Prometheus scrapes both.
Environment=HIGHFREQ_FUTURES_INGEST_METRICS_PORT=9100

ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.futures_runner

Restart=always
RestartSec=10
# Same memory budget as spot — depth20 frames at 100ms × 3 symbols
# is roughly the same wire load whether spot or futures venue.
MemoryMax=400M
MemoryHigh=300M
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

# Graceful shutdown: SIGTERM lets the consumer stop cleanly + the
# aggregator flush any pending Postgres writes before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
