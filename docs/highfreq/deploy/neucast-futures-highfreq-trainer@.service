[Unit]
Description=NeuCast HF CatBoost Trainer (USDM Futures) for %I — oneshot, release S phase 3
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service
Wants=docker.service

# Instance name = lowercase symbol, e.g. ``btcusdt``. Mirrors the
# spot trainer template's contract; differs only in --venue + the
# output sub-directory.

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
Environment=OMP_NUM_THREADS=2

# --venue futures pulls from highfreq_futures_ofi_1s. Output goes
# to weights/highfreq/futures/<sym>_1m.cbm so spot vs futures
# weights don't collide on the same (symbol, horizon).
ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.trainer \
    --symbol %I \
    --venue futures \
    --since-hours 72 \
    --bar-minutes 1 \
    --out /opt/neucast/weights/highfreq/futures/%i_1m.cbm \
    --report /opt/neucast/weights/highfreq/futures/%i_1m_metrics.json \
    --frozen-holdout-days 0

# Same exit-code semantics as spot: 0 = at least one fold, 1 = no
# folds yet (early-bootstrap or insufficient data) — both treated as
# successful so the timer doesn't accumulate failed-state during
# the data-accumulation phase.
SuccessExitStatus=0 1

MemoryMax=2500M
MemoryHigh=2000M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=1800

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
# Activated by neucast-futures-highfreq-trainer@<sym>.timer.
