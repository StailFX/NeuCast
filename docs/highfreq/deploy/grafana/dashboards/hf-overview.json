{
  "title": "NeuCast HF · Overview",
  "uid": "hf-overview",
  "tags": ["neucast", "hft"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "row", "id": 100,
      "title": "Ingest pipeline",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat", "id": 1, "title": "WS frames / sec",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "rate(neucast_hf_ws_frames_total[1m])", "legendFormat": "frames/s"}],
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 0}}
    },
    {
      "type": "stat", "id": 2, "title": "WS reconnects (1h)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "increase(neucast_hf_ws_reconnects_total[1h])", "legendFormat": "reconnects"}],
      "options": {"colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}
      ]}}}
    },
    {
      "type": "timeseries", "id": 3, "title": "OFI rows written / sec by symbol",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "rate(neucast_hf_ofi_rows_written_total[1m])", "legendFormat": "{{symbol}}"}]
    },
    {
      "type": "timeseries", "id": 4, "title": "L2 snapshots written / sec by symbol",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "rate(neucast_hf_l2_snapshots_written_total[1m])", "legendFormat": "{{symbol}}"}]
    },
    {
      "type": "timeseries", "id": 5, "title": "Snapshots dispatched / sec by symbol",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "rate(neucast_hf_snapshots_dispatched_total[1m])", "legendFormat": "{{symbol}}"}]
    },

    {
      "type": "row", "id": 200,
      "title": "Predictor",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}
    },
    {
      "type": "stat", "id": 6, "title": "Calibrated?",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_predictor_calibrated", "legendFormat": "{{symbol}}"}],
      "options": {"colorMode": "value"},
      "fieldConfig": {"defaults": {"mappings": [
        {"type": "value", "options": {"0": {"text": "no", "color": "red"}, "1": {"text": "yes", "color": "green"}}}
      ]}}
    },
    {
      "type": "stat", "id": 7, "title": "dir_acc CI low",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_predictor_dir_acc_ci_low", "legendFormat": "{{symbol}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3, "min": 0.4, "max": 0.6,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.51}
        ]}}}
    },
    {
      "type": "stat", "id": 8, "title": "Model age",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_predictor_model_age_seconds", "legendFormat": "{{symbol}}"}],
      "fieldConfig": {"defaults": {"unit": "s",
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null}, {"color": "yellow", "value": 86400}, {"color": "red", "value": 604800}
        ]}}}
    },
    {
      "type": "timeseries", "id": 9, "title": "Predictions / min by signal",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "rate(neucast_hf_predictions_total[5m]) * 60", "legendFormat": "{{symbol}}/{{signal}}"}]
    },
    {
      "type": "timeseries", "id": 10, "title": "Prediction latency p50/p95/p99",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(neucast_hf_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p50 {{symbol}}"},
        {"expr": "histogram_quantile(0.95, rate(neucast_hf_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p95 {{symbol}}"},
        {"expr": "histogram_quantile(0.99, rate(neucast_hf_prediction_latency_seconds_bucket[5m]))", "legendFormat": "p99 {{symbol}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },

    {
      "type": "row", "id": 300,
      "title": "Paper trader",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}
    },
    {
      "type": "stat", "id": 11, "title": "Halted?",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_paper_trader_halted{reason!=\"none\"}", "legendFormat": "{{symbol}} ({{reason}})"}],
      "options": {"colorMode": "value"},
      "fieldConfig": {"defaults": {"mappings": [
        {"type": "value", "options": {"0": {"text": "running", "color": "green"}, "1": {"text": "HALT", "color": "red"}}}
      ]}}
    },
    {
      "type": "stat", "id": 12, "title": "Loss streak",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_paper_consecutive_losses", "legendFormat": "{{symbol}}"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 5}
      ]}}}
    },
    {
      "type": "timeseries", "id": 13, "title": "Trades opened/closed per minute",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [
        {"expr": "rate(neucast_hf_paper_trades_opened_total[5m]) * 60", "legendFormat": "open {{symbol}}/{{side}}"},
        {"expr": "rate(neucast_hf_paper_trades_closed_total[5m]) * 60", "legendFormat": "close {{symbol}}/{{exit_reason}}"}
      ]
    },
    {
      "type": "timeseries", "id": 14, "title": "Cumulative P&L (wins − losses) USD",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 33},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "neucast_hf_paper_pnl_usd_total - neucast_hf_paper_loss_usd_total", "legendFormat": "{{symbol}}"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },

    {
      "type": "row", "id": 400,
      "title": "Tokyo system (node_exporter)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40}
    },
    {
      "type": "stat", "id": 15, "title": "RAM used",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 41},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes"}],
      "fieldConfig": {"defaults": {"unit": "percentunit",
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}
        ]}}}
    },
    {
      "type": "stat", "id": 16, "title": "Disk used (root)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 41},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})"}],
      "fieldConfig": {"defaults": {"unit": "percentunit",
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}
        ]}}}
    },
    {
      "type": "timeseries", "id": 17, "title": "CPU usage % (1m avg)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 41},
      "datasource": {"type": "prometheus", "uid": "prom-tokyo"},
      "targets": [{"expr": "1 - rate(node_cpu_seconds_total{mode=\"idle\"}[1m])", "legendFormat": "{{cpu}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    }
  ]
}
