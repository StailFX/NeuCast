[Unit]
Description=NeuCast High-Frequency L2 Ingest (Phase A)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
Environment=PATH=/opt/neucast/venv/bin:/usr/bin
# Replace ${POSTGRES_PASSWORD} with the real value or use an EnvironmentFile=
Environment=DATABASE_URL=postgresql://neucast:${POSTGRES_PASSWORD}@127.0.0.1:5433/neucast
Environment=HIGHFREQ_SYMBOLS=BTCUSDT
Environment=HIGHFREQ_DEPTH_LEVELS=20
Environment=HIGHFREQ_UPDATE_SPEED_MS=100
Environment=HIGHFREQ_FLUSH_BATCH=5
Environment=LOG_LEVEL=INFO
# Suppress TensorFlow noise that comes from app/__init__.py side-imports.
Environment=TF_CPP_MIN_LOG_LEVEL=3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.runner
Restart=always
RestartSec=5
# Coexist with neucast.service / neucast-celery.service on shared 8 GB VPS.
# See ADR-006 — soft cap, kernel will OOM-kill before host swaps to death.
MemoryMax=1500M
MemoryHigh=1200M
# Keep the consumer responsive even under load — websocket is latency-sensitive.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
