[Unit]
Description=NeuCast HFT — USDM Futures funding-rate REST poller (Release S phase 3)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service neucast-futures-highfreq.service
# Soft-dependency on the ingest service: we want to backfill funding
# rate into rows the ingest just wrote, but a missing ingest doesn't
# block this poller (the UPDATE just touches 0 rows then).
Wants=neucast-futures-highfreq.service

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
Environment=LOG_LEVEL=INFO

ExecStart=/opt/neucast/venv/bin/python -m tools.poll_funding_rate \
    --symbols BTCUSDT ETHUSDT BNBUSDT \
    --backfill-minutes 6

# Exit 0 when at least one symbol's poll succeeded; 1 when all
# symbols failed (transient REST outage). Systemd's failure tracking
# will surface persistent failures via the timer.
SuccessExitStatus=0

# Resource limits — REST GET + per-symbol UPDATE is trivial work.
MemoryMax=100M
Nice=10
TimeoutStartSec=60

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
# Activated by neucast-futures-funding-poll.timer.
