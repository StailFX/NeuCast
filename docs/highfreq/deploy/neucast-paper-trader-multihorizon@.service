[Unit]
Description=NeuCast Paper Trader (multi-horizon) for %I — Phase C, sim-only ADR-005, release R 2026-04-29
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service neucast-highfreq.service
Wants=neucast-highfreq.service

# Instance name format: <symbol>-h<horizon>m (e.g. "btcusdt-h15m",
# "ethusdt-h60m"). The wrapper script parses %I and exports
# HIGHFREQ_PAPER_SYMBOL + HF_HORIZON_MINUTES before exec'ing the
# runner. Wrapper is a separate file because systemd's ${} expansion
# would clobber bash's ${} parameter expansion if inlined here.
# The 1m runner keeps using the existing neucast-paper-trader@%I.service
# template (instance="btcusdt") for backward compat — no changes there.

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env

ExecStart=/opt/neucast/tools/run_paper_trader_multihorizon.sh %i

Restart=always
RestartSec=10
MemoryMax=300M
MemoryHigh=200M
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

# Graceful shutdown: SIGTERM lets the loop run its force_close path
# (flatten any open position, persist the closing trade) before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# Hot-fix 2026-05-06: ReadWritePaths must include BOTH textfile-collector
# dirs. /var/lib/node_exporter is the upstream-docs path (some tools
# still target it); /var/lib/prometheus/node-exporter is what the
# Debian ``prometheus-node-exporter`` package actually scrapes — and
# it's where ``app/highfreq/cron_metrics.py`` writes by default. The
# original H-1sec landing only listed the first path, so EVERY cron
# heartbeat write hit EROFS for two days until the L2-archive-stale
# alert finally fired (which is itself a heartbeat-based rule).
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/lib/prometheus/node-exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
