[Unit]
# NeuCast HF — frozen-holdout evaluator (per-symbol via systemd template).
# Runs `tools.eval_frozen_holdout` against the deployed .cbm. Writes a
# JSON report to weights/highfreq/<sym>_1m_holdout.json that the web
# UI surfaces alongside the walk-forward training report.
#
# Invoke as `systemctl start neucast-highfreq-holdout-eval@btcusdt.service`
# (lowercase symbol to match the .cbm filename convention).
Description=NeuCast HF Frozen-Holdout Evaluator (%I)
Documentation=file:///opt/neucast/tools/eval_frozen_holdout.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
# `%I` is the lowercase symbol (e.g. "btcusdt") — eval_frozen_holdout
# uppercases internally before hitting the DB. Same %I conventions as
# the trainer template service so an operator only needs to remember
# one rule.
ExecStart=/opt/neucast/venv/bin/python -m tools.eval_frozen_holdout --symbol %I
StandardOutput=journal
StandardError=journal

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
