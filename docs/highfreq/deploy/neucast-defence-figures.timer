[Unit]
Description=NeuCast defence-figures rendering schedule — daily 05:00 UTC
Documentation=file:///opt/neucast/docs/defence/figures/README.md

[Timer]
# 05:00 UTC daily — strictly after all training jobs finish.
# Sequence:
#   * 04:00 — solo per-symbol trainers (3 timers, 5min jitter)
#   * 04:30 — Monday-only frozen-holdout eval
#   * 04:45 — multi-horizon trainers
#   * 04:50 — joint multi-symbol trainer
#   * 05:00 — defence figures (this) — reads ALL of the above
#
# Defence figures depend on every preceding trainer's metrics file,
# so we wait until the latest writer settles. Wallclock for the
# render itself is ~5 seconds. Output lands in
# /opt/neucast/weights/highfreq/figures/ — operator pulls with scp
# when slides need a refresh.
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
RandomizedDelaySec=120

# Implicit Unit=neucast-defence-figures.service.

[Install]
WantedBy=timers.target
