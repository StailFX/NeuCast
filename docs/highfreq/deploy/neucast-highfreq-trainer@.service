[Unit]
Description=NeuCast HF CatBoost Trainer for %I (oneshot, fired by .timer)
Documentation=file:///opt/neucast/docs/highfreq/architecture.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env
Environment=OMP_NUM_THREADS=2

# %I = unescaped instance name (e.g. "btcusdt"). Trainer uppercases
# --symbol internally; weights/report files are written lowercase to
# match predictor.weights_path_for_symbol convention.
#
# ``--since-hours 93``: use the maximum history we have on disk
# (ETH/BNB capped at 3.9 days = 93h). Release T.13 (2026-04-30)
# bumped this from 72h after a grid A/B (tools/grid_search) showed
# +0.5-1.5pp on conf60 accuracy across all three symbols — more bars
# tightens fold count + CI without overfitting since we still aren't
# data-rich enough to overfit on this feature dimensionality. Once
# we accumulate >7 days of data, bump to 168 (7d) and re-evaluate.
#
# Per-symbol ExecStart is overridden in /etc/systemd/system/
# neucast-highfreq-trainer@{ethusdt,bnbusdt}.service.d/feature-set.conf
# to add ``--feature-set cross_asset`` (BTC stays microstructure;
# A/B showed cross_asset is -0.4pp for BTC since pointing-at-itself
# yields no extra signal).
ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.trainer \
    --symbol %I \
    --since-hours 93 \
    --out /opt/neucast/weights/highfreq/%i_1m.cbm \
    --report /opt/neucast/weights/highfreq/%i_1m_metrics.json \
    --frozen-holdout-days 0

# Bootstrap mode: ``--frozen-holdout-days 0`` disables the holdout
# split until we have >> 7 days of data. With < 7 days the cutoff
# (now - 7d) lands BEFORE all our data, so the trainer's
# ``meta["minute"] < cutoff`` mask is all-False and the train set
# becomes empty — no folds, no .cbm written. Bootstrap mode lets the
# trainer fit on the full dataset.
#
# Once we have ~14 days of accumulated data, raise this to 7 (or any
# value < days_of_data - 1) so the holdout becomes meaningful.
# Tracked in docs/highfreq/live-trading-architecture.md.

# Trainer exit codes (see neucast-highfreq-trainer.service for full
# discussion): 0 = at least one fold; 1 = "no folds yet" — both treated
# as success so the timer doesn't accumulate failed-state during ramp-up.
SuccessExitStatus=0 1

MemoryMax=2500M
MemoryHigh=2000M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=1800

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
# Activated by the .timer template, not socket / multi-user.
