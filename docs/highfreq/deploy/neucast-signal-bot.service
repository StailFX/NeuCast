[Unit]
Description=NeuCast Signals — Telegram interactive bot worker
Documentation=file:///opt/neucast/app/highfreq/telegram_bot_worker.py
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=stailfx
Group=stailfx
WorkingDirectory=/opt/neucast
EnvironmentFile=/etc/neucast/env

# Long-polling worker — handles /stats, /trades, /accuracy, /model.
# Outbound-only HTTP (no listening port to firewall).
ExecStart=/opt/neucast/venv/bin/python -m app.highfreq.telegram_bot_worker

# Restart on failure but back off so a misconfigured token doesn't
# spin in tight retries.
Restart=on-failure
RestartSec=10s

# Tiny memory footprint — urllib + asyncpg + sqlalchemy. ~50 MB
# resident; cap at 200 MB defensively.
MemoryMax=200M
MemoryHigh=150M
Nice=10

# Standard logging.
StandardOutput=journal
StandardError=journal

# Code-review H-1sec (2026-05-04): systemd hardening — defence-in-depth.
# A compromise of any of these processes (malicious .cbm planted via a
# future write-path bug, etc.) gets a sandbox by default: no /tmp leak,
# no /home access, no setuid escalation, no kernel tunables, no
# unrelated address families. ReadWritePaths whitelists weights +
# textfile_collector + journal-side /var/log so the actual job still
# works. Loosen per-unit ONLY if a service genuinely needs it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/neucast /var/lib/node_exporter /var/log
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
